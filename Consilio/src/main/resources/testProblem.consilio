define problem robotProblemExample
import domainExample

objects{
    robots robot[] = {r1};
    packages package[] = {p1, p2, p3};
    rooms room[] = {ro1, ro2};
}

initialState{
    robots[0].location = rooms[0];
    robots[0,1].carryingObject = false;
    packages[0,2].location = rooms[1];
}

goalState{
    packages[0,1].location == rooms[2] && packages[2].location == rooms[4] && packages[0,1,2].numberOfItems == 2;
}
