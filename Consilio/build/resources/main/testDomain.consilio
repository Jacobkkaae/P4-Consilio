define domain domainExample

type robot {
    location: room;
    carryingObject: boolean;
}

type room {

}

type package {
    location: room || robot;
    numberOfItems: int;
}

action pickUpPackage(robot r, package p){
    if(r.carryingObject == false && r.location == p.location){
        p.location = r;
        r.carryingObject = true;
        p.numberOfItems = p.numberOfItems + 1 + 3;
    }
}
